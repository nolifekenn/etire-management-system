# ═══════════════════════════════════════════════════════════════════════════
# .env.local.template — eTire Management System
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` to version control.
# ═══════════════════════════════════════════════════════════════════════════

# ── Supabase (Required) ──────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API

# Your project's public API URL
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co

# "anon" (public) key — safe to expose in the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Service-role key — NEVER expose to the browser; only used in server actions
# (supabaseServer.ts uses this via createClient on the server)
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# JWT secret (used if you need to verify tokens server-side)
# Found in: Supabase Dashboard → Project Settings → API → JWT Settings
SUPABASE_JWT_SECRET=<your-jwt-secret>

# ── Next.js Public URL (required for CORS / absolute URL generation) ─────────
# Development:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production (Vercel): set to your deployed domain, e.g.:
# NEXT_PUBLIC_SITE_URL=https://etire.yourdomain.com

# ── Vercel Analytics (optional — auto-populated by Vercel) ──────────────────
# These are auto-injected by the Vercel platform during build.
# You do NOT need to set them manually for Vercel deployments.
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=<auto>

# ── Report Token Secret ───────────────────────────────────────────────────────
# Used by src/lib/reportToken.ts to sign/verify temporary download tokens.
# Generate with: openssl rand -hex 32
REPORT_TOKEN_SECRET=<random-64-char-hex-string>

# ── Feature Flags (optional) ──────────────────────────────────────────────────
# Set to "true" to enable WIP modules in production
NEXT_PUBLIC_ENABLE_CHATTER=true
NEXT_PUBLIC_ENABLE_WORKSHOP=true
NEXT_PUBLIC_ENABLE_PURCHASING=true

# ═══════════════════════════════════════════════════════════════════════════
# Vercel Environment Variable Setup
# ───────────────────────────────────────────────────────────────────────────
# In your Vercel project dashboard go to:
#   Settings → Environment Variables
#
# Add ALL variables above (both NEXT_PUBLIC_* and server-only).
# Mark SUPABASE_SERVICE_ROLE_KEY and SUPABASE_JWT_SECRET as "Sensitive"
# so they are hidden in the Vercel UI.
#
# Environment targets:
#   NEXT_PUBLIC_SUPABASE_URL         → Production, Preview, Development
#   NEXT_PUBLIC_SUPABASE_ANON_KEY    → Production, Preview, Development
#   SUPABASE_SERVICE_ROLE_KEY        → Production, Preview (NOT Development)
#   REPORT_TOKEN_SECRET              → Production, Preview
# ═══════════════════════════════════════════════════════════════════════════
