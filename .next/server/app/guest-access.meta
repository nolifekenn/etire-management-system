{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/guest-access/layout,_N_T_/guest-access/page,_N_T_/guest-access"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/guest-access/__PAGE__",
    "/guest-access",
    "/_index",
    "/_head"
  ]
}